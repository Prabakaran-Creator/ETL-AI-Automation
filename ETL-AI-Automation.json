    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map((item, index) => {\nlet raw = item.json.output ?? item.json.text ?? item.json.response ?? item.json;\n\nif (typeof raw === 'object' && raw !== null) {\nreturn {\njson: raw\n};\n}\n\nraw = String(raw).trim();\n\nraw = raw\n.replace(/^json\\s*/i, '') .replace(/^\\s*/i, '')\n.replace(/\\s*```$/i, '')\n.trim();\n\ntry {\nreturn {\njson: JSON.parse(raw)\n};\n} catch (error) {\nconst start = raw.indexOf('{');\nconst end = raw.lastIndexOf('}');\n\n}\n});"
      },
